{
  "name": "claude-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.13.0",
  "scripts": {
    "dev": "pnpm run build && node server/index.js",
    "dev:client": "pnpm --filter ./client run dev",
    "build": "pnpm --filter ./client run build",
    "start": "node server/index.js",
    "test": "node --experimental-test-module-mocks --test 'test/**/*.test.js'",
    "test:e2e": "pnpm run build && playwright test",
    "install:all": "pnpm install",
    "setup:hooks": "node scripts/setup-hooks.js",
    "setup:statusline": "node scripts/setup-statusline.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config --get core.hooksPath >/dev/null || lefthook install"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "express": "^5.0.0",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.6"
  },
  "engines": {
    "node": ">=24"
  }
}
