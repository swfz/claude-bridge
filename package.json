{
  "name": "claude-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.22.0",
  "scripts": {
    "dev": "pnpm run build && node server/index.js",
    "dev:client": "pnpm --filter ./client run dev",
    "build": "pnpm --filter ./client run build",
    "start": "node server/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm run build && playwright test",
    "install:all": "pnpm install",
    "setup:hooks": "node scripts/setup-hooks.js",
    "setup:statusline": "node scripts/setup-statusline.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config --get core.hooksPath >/dev/null || lefthook install",
    "mutation": "mutator"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "express": "^5.0.0",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mizchi/mutator": "0.4.5",
    "@playwright/test": "1.65.1",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "lefthook": "2.2.2",
    "prettier": "3.10.1",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
